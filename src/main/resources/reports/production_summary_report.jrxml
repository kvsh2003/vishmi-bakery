<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="production_summary_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <queryString>
        <![CDATA[SELECT pb.production_batch_id, p.name AS product_name, pb.produced_on, pb.planned_qty, pb.actual_qty, pb.status FROM production_batch pb JOIN product p ON p.product_id=pb.product_id ORDER BY pb.produced_on DESC, pb.production_batch_id DESC]]>
    </queryString>
    <field name="production_batch_id" class="java.lang.Long"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="produced_on" class="java.sql.Date"/>
    <field name="planned_qty" class="java.math.BigDecimal"/>
    <field name="actual_qty" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>
    <title>
        <band height="65">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="55" backcolor="#1E4D37"/>
            </rectangle>
            <staticText>
                <reportElement x="15" y="8" width="300" height="22" forecolor="#FFFFFF"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[VISHMI BAKEHOUSE]]></text>
            </staticText>
            <staticText>
                <reportElement x="15" y="30" width="300" height="16" forecolor="#D0E3D8"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Daily Production Batches & Output Summary]]></text>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="22" backcolor="#F4F6F3"/>
            </rectangle>
            <staticText>
                <reportElement x="10" y="4" width="60" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Batch #]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="4" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="4" width="180" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="4" width="50" height="16"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Planned]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="4" width="50" height="16"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Actual]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="4" width="50" height="16"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="22">
            <textField>
                <reportElement x="10" y="3" width="60" height="16"/>
                <textFieldExpression><![CDATA[$F{production_batch_id}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="80" y="3" width="100" height="16"/>
                <textFieldExpression><![CDATA[$F{produced_on}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="190" y="3" width="180" height="16"/>
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="380" y="3" width="50" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{planned_qty}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="440" y="3" width="50" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{actual_qty}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="500" y="3" width="50" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="21" width="555" height="1" forecolor="#E2E8E4"/>
            </line>
        </band>
    </detail>
</jasperReport>
