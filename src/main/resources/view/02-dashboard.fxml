<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="950.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.vishmibakehouse.controller.DashboardController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
         <children>
            <!-- Title & Subtitle -->
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="page-title" text="Daily overview" />
                        <Label styleClass="page-subtitle" text="Production, sales, deliveries, and stock status at a glance." />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-secondary" text="🔄 Refresh Data" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- 4 Metric Cards -->
            <HBox spacing="16.0">
               <children>
                  <VBox prefWidth="220.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="TODAY'S SALES" />
                        <Label fx:id="lblMetricSales" styleClass="metric-value" text="LKR 0.00">
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox prefWidth="220.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="UNITS PRODUCED" />
                        <Label fx:id="lblMetricProduction" styleClass="metric-value" text="0 units">
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox prefWidth="220.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="PENDING DELIVERIES" />
                        <Label fx:id="lblMetricDeliveries" styleClass="metric-value" text="0 orders">
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox prefWidth="220.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="LOW STOCK ALERTS" />
                        <Label fx:id="lblMetricStockAlerts" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #DC2626;" text="0 items">
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Dual Tables (Today's Production & Attention Needed) -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Today's Production Table -->
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-header" text="Today's Production Batches" />
                        <TableView fx:id="tblTodayProduction" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colProdBatchId" prefWidth="60.0" text="Batch" />
                              <TableColumn fx:id="colProdProduct" prefWidth="170.0" text="Product" />
                              <TableColumn fx:id="colProdPlanned" prefWidth="90.0" text="Planned" />
                              <TableColumn fx:id="colProdActual" prefWidth="90.0" text="Actual" />
                              <TableColumn fx:id="colProdStatus" prefWidth="100.0" text="Status" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- Attention Needed / Low Stock Ingredients Table -->
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-header" text="Attention Needed (Stock Reorder Alerts)" />
                        <TableView fx:id="tblLowStock" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colStockIngredient" prefWidth="180.0" text="Ingredient" />
                              <TableColumn fx:id="colStockUnit" prefWidth="70.0" text="Unit" />
                              <TableColumn fx:id="colStockAvailable" prefWidth="110.0" text="Available Qty" />
                              <TableColumn fx:id="colStockReorder" prefWidth="110.0" text="Reorder Level" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

