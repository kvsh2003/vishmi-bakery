<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="950.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.vishmibakehouse.controller.UsageController">
   <children>
      <VBox spacing="16.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="page-title" text="Ingredient usage" />
                  <Label styleClass="page-subtitle" text="Deduct raw ingredients consumed per production batch to maintain real-time inventory balances." />
               </children>
            </VBox>

            <!-- Form Card -->
            <VBox spacing="12.0" styleClass="card">
               <children>
                  <GridPane hgap="16.0" vgap="12.0">
                     <children>
                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="field-label" text="Production Batch *" />
                              <ComboBox fx:id="cmbBatch" maxWidth="1.7976931348623157E308" promptText="Select batch" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="field-label" text="Ingredient *" />
                              <ComboBox fx:id="cmbIngredient" maxWidth="1.7976931348623157E308" promptText="Select ingredient" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="field-label" text="Current Stock Available" />
                              <Label fx:id="lblAvailableStock" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E4D37;" text="--">
                                 <VBox.margin>
                                    <Insets top="6.0" />
                                 </VBox.margin>
                              </Label>
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <children>
                              <Label styleClass="field-label" text="Quantity Used *" />
                              <TextField fx:id="txtQty" promptText="e.g. 15.5" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label styleClass="field-label" text="Recorded By *" />
                              <ComboBox fx:id="cmbEmployee" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <!-- Buttons -->
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleSave" styleClass="btn-primary" text="Log Ingredient Usage" />
                        <Button mnemonicParsing="false" onAction="#handleClear" styleClass="btn-secondary" text="Clear Form" />
                     </children>
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>

            <!-- Table Card -->
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="section-header" text="Ingredient Consumption Log" />
                  <TableView fx:id="tblUsages" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colBatch" prefWidth="90.0" text="Batch #" />
                        <TableColumn fx:id="colProduct" prefWidth="170.0" text="Product" />
                        <TableColumn fx:id="colIngredient" prefWidth="180.0" text="Ingredient" />
                        <TableColumn fx:id="colQty" prefWidth="100.0" text="Qty Used" />
                        <TableColumn fx:id="colDate" prefWidth="150.0" text="Logged Time" />
                        <TableColumn fx:id="colStaff" prefWidth="140.0" text="Recorded By" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

