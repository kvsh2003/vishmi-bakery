<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="950.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.vishmibakehouse.controller.ReportsController">
   <children>
      <VBox spacing="16.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="page-title" text="Reports &amp; analytics" />
                  <Label styleClass="page-subtitle" text="Generate dynamic JasperReports business intelligence summaries, sales audits, and export PDFs." />
               </children>
            </VBox>

            <!-- Report Configuration Card -->
            <VBox spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="section-header" text="Report Parameters &amp; Export Options" />
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <children>
                        <VBox spacing="4.0" prefWidth="300.0">
                           <children>
                              <Label styleClass="field-label" text="Select Report Type *" />
                              <ComboBox fx:id="cmbReportType" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="180.0">
                           <children>
                              <Label styleClass="field-label" text="From Date" />
                              <DatePicker fx:id="dtFromDate" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="180.0">
                           <children>
                              <Label styleClass="field-label" text="To Date" />
                              <DatePicker fx:id="dtToDate" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox alignment="BOTTOM_LEFT" spacing="4.0">
                           <children>
                              <HBox spacing="10.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#handleViewReport" prefHeight="36.0" styleClass="btn-primary" text="👁️ View Report" />
                                    <Button mnemonicParsing="false" onAction="#handleExportPdf" prefHeight="36.0" styleClass="btn-secondary" text="📄 Export PDF" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Financial Summary & Recent Daily Sales Table -->
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="section-header" text="Daily Financial Sales Summary (v_daily_sales)" />
                  <TableView fx:id="tblDailySales" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colSaleDate" prefWidth="180.0" text="Date" />
                        <TableColumn fx:id="colTransactions" prefWidth="180.0" text="Total Transactions" />
                        <TableColumn fx:id="colTotalRevenue" prefWidth="240.0" text="Daily Total Revenue (LKR)" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
