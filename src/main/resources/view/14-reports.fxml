<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="980.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.vishmibakehouse.controller.ReportsController">
   <children>
      <VBox spacing="14.0" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="22.0" AnchorPane.rightAnchor="22.0" AnchorPane.topAnchor="18.0">
         <children>
            <!-- Page Header -->
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="page-title" text="Business Intelligence &amp; Audit Reports" />
                        <Label styleClass="page-subtitle" text="Itemized transaction audits, sales summaries, fleet distribution, and official JasperReports export." />
                     </children>
                  </VBox>
                  <Pane HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleViewReport" prefHeight="36.0" styleClass="btn-primary" text="👁️ View Full Report" />
                        <Button mnemonicParsing="false" onAction="#handleExportPdf" prefHeight="36.0" styleClass="btn-secondary" text="📄 Export PDF" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- 4 Executive KPI Metric Cards (Date Filter Range) -->
            <HBox spacing="14.0">
               <children>
                  <VBox prefWidth="200.0" styleClass="metric-card" style="-fx-border-color: #DFE5E1 #DFE5E1 #DFE5E1 #10B981; -fx-border-width: 1px 1px 1px 4px;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="PERIOD TOTAL SALES" />
                        <Label fx:id="lblPeriodSales" styleClass="metric-value" text="LKR 0.00">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox prefWidth="200.0" styleClass="metric-card" style="-fx-border-color: #DFE5E1 #DFE5E1 #DFE5E1 #0EA5E9; -fx-border-width: 1px 1px 1px 4px;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="TOTAL UNITS SOLD" />
                        <Label fx:id="lblPeriodItems" styleClass="metric-value" text="0 units">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox prefWidth="200.0" styleClass="metric-card" style="-fx-border-color: #DFE5E1 #DFE5E1 #DFE5E1 #F59E0B; -fx-border-width: 1px 1px 1px 4px;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="TRANSACTION COUNT" />
                        <Label fx:id="lblPeriodOrders" styleClass="metric-value" text="0 sales">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox prefWidth="200.0" styleClass="metric-card" style="-fx-border-color: #DFE5E1 #DFE5E1 #DFE5E1 #8B5CF6; -fx-border-width: 1px 1px 1px 4px;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="metric-title" text="AVERAGE TICKET / SALE" />
                        <Label fx:id="lblPeriodAvg" styleClass="metric-value" text="LKR 0.00">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Report Configuration Card -->
            <VBox spacing="10.0" styleClass="card">
               <children>
                  <Label styleClass="section-header" text="Audit Parameters &amp; Filter Settings" />
                  <HBox alignment="CENTER_LEFT" spacing="14.0">
                     <children>
                        <VBox spacing="4.0" prefWidth="320.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="field-label" text="Select Report Type *" />
                              <ComboBox fx:id="cmbReportType" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="170.0">
                           <children>
                              <Label styleClass="field-label" text="From Date" />
                              <DatePicker fx:id="dtFromDate" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="170.0">
                           <children>
                              <Label styleClass="field-label" text="To Date" />
                              <DatePicker fx:id="dtToDate" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox alignment="BOTTOM_LEFT">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleFilterData" prefHeight="35.0" styleClass="btn-secondary" text="🔄 Filter &amp; Refresh" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Detailed Itemized Sales & Transaction Audit Table -->
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblTableTitle" styleClass="section-header" text="Itemized Counter Sales Audit Log (Full Details)" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblRecordCount" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5E7166;" text="0 records found" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblItemizedSales" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colSaleId" prefWidth="60.0" text="Sale #" />
                        <TableColumn fx:id="colSaleTime" prefWidth="135.0" text="Date &amp; Time" />
                        <TableColumn fx:id="colCashier" prefWidth="125.0" text="Cashier Staff" />
                        <TableColumn fx:id="colProduct" prefWidth="175.0" text="Product Item" />
                        <TableColumn fx:id="colCategory" prefWidth="90.0" text="Category" />
                        <TableColumn fx:id="colQty" prefWidth="60.0" text="Qty" />
                        <TableColumn fx:id="colUnitPrice" prefWidth="95.0" text="Unit Price (LKR)" />
                        <TableColumn fx:id="colLineTotal" prefWidth="105.0" text="Line Total (LKR)" />
                        <TableColumn fx:id="colCashReceived" prefWidth="85.0" text="Paid (LKR)" />
                        <TableColumn fx:id="colChange" prefWidth="80.0" text="Change" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
